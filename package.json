{
  "name": "afrideck",
  "version": "0.1.0",
  "private": true,
  "description": "Afrikaans vocabulary Telegram bot with spaced repetition and audio pronunciation",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "build": "tsc --noEmit",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "build-wordlist": "tsx scripts/build-wordlist.ts",
    "generate-sentences": "tsx scripts/generate-sentences.ts",
    "seed-redis": "tsx scripts/seed-redis.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/node": "^3.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
